APP_NAME=MediConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mediconnect
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# local: almacenamiento privado en disco; AWS: s3 (requiere aws/aws-sdk-php)
MEDICAL_FILES_DISK=local
REPORTS_DISK=local

# local: base de datos; AWS: sqs. El resto de la configuración no cambia.
QUEUE_CONNECTION=database
QUEUE_TABLE=jobs
QUEUE_NAME=default
NOTIFICATIONS_QUEUE=notificaciones
REPORTS_QUEUE=reportes

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# local: log (no envía correos reales); AWS: ses (Amazon SES).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="avisos@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Credenciales de AWS. No escribir valores reales en el repositorio.
# En AWS, el rol de la tarea ECS puede inyectarlas sin claves estáticas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SQS: en AWS descomentar y ajustar la URL de la cuenta y los nombres.
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/123456789012
# SQS_QUEUE=mediconnect-default
# SQS_SUFFIX=
# NOTIFICATIONS_QUEUE=notificaciones
# REPORTS_QUEUE=reportes
# Cola de fallidos estándar de Laravel (php artisan queue:failed).
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_FAILED_TABLE=failed_jobs

# SES usa services.ses con las mismas credenciales AWS.
# La dirección MAIL_FROM_ADDRESS debe estar verificada en SES.

# Videollamada: Jitsi es el prototipo sin costo. En producción se reemplaza
# por una implementación de Amazon Chime SDK detrás de VideoProvider.
VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si
VIDEO_ROOM_PREFIX=mediconnect
VIDEO_WINDOW_BEFORE_MINUTES=15
VIDEO_WINDOW_AFTER_MINUTES=15

VITE_APP_NAME="${APP_NAME}"

# Sanctum (SPA): origenes del backend y del frontend
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,127.0.0.1:3000
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
